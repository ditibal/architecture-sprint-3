@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "Пользователь", "Управляет умным домом через веб или мобильное приложение")

System_Boundary("SmartHomeSystem", "Система умного дома") {
    Container(apiGateway, "API Gateway", "Nginx/Kong", "Единая точка входа для всех клиентских запросов. Маршрутизация и проверка прав, управление нагрузкой")
    Container(deviceOrchestratorService, "Device Orchestrator Service", "Java/Spring", "Оркестратор команд всех устройств")
    Container(sensorService, "Sensor Monitoring Service", "Java/Spring", "Сбор и хранение данных с любых датчиков")
    Container(deviceService, "Device Management Service", "Java/Spring", "Управление устройствами умного дома (регистрация, состояние)")
    Container(userService, "User Management Service", "Java/Spring", "Управление пользователями (регистрация, аутентификация)")
    Container(scenarioService, "Scenario Management Service", "Java/Spring", "Создание и управление пользовательскими сценариями")
    Container(notificationService, "Notification Service", "Java/Spring", "Отправка любых уведомлений пользователям")
    ContainerDb(userDb, "User DB", "PostgreSQL", "Данные пользователей")
    ContainerDb(sensorDb, "Sensor Info DB", "InfluxDB", "Данные датчиков")
    ContainerDb(deviceDb, "Device DB", "MongoDB", "Информация об устройствах и их состоянии")
    ContainerDb(scenarioDb, "Scenario DB", "PostgreSQL", "Данные пользовательских сценариев")
    SystemQueue(kafka, "Kafka", "Apache Kafka", "Шина данных для событий")
}

System_Ext(devices, "Устройства умного дома", "Различные датчики и другие устройства")

Rel(user, apiGateway, "Отправляет запросы для управления устройствами", "JSON/HTTPS")

Rel(apiGateway, deviceOrchestratorService, "Маршрутизирует запросы управления любыми устройствами")
Rel(apiGateway, sensorService, "Маршрутизирует запросы на получение данных с любых датчиков")
Rel(apiGateway, deviceService, "Маршрутизирует запросы для управления устройствами")
Rel(apiGateway, userService, "Маршрутизирует запросы для управления пользователями")
Rel(apiGateway, scenarioService, "Маршрутизирует запросы для управления сценариями")
Rel(apiGateway, notificationService, "Маршрутизирует запросы для отправки уведомлений")

Rel(deviceOrchestratorService, kafka, "Публикует данные комманд устройств", "JSON")
Rel(deviceService, kafka, "Публикует события устройств", "JSON")
Rel(kafka, sensorService, "Передаёт данные с датчиков", "JSON")
Rel(kafka, notificationService, "Передаёт события и изменения состояния устройств", "JSON")

Rel(userService, userDb, "Читает и записывает данные пользователей")
Rel(sensorService, sensorDb, "Читает и записывает данные с датчиков")
Rel(deviceService, deviceDb, "Читает и записывает информацию об устройствах")
Rel(scenarioService, scenarioDb, "Читает и записывает пользовательские сценарии")

Rel(devices, kafka, "Обменивается данными через протоколы MQTT/HTTP")
@enduml